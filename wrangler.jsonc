{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neobet-intelligence",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
